rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {

      // =========================
      // AUTH HELPERS
      // =========================
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(uid) {
        return request.auth.uid == uid;
      }

      // The single platform administrator (mirrors ADMIN_UID in lib/core/admin.dart).
      // Governs the club-request review flow and the club-members bootstrap.
      function isAdmin() {
        return request.auth.uid == 'OImOQirOL7eQNftKASo4FTrF6XA3';
      }

      // Canonical collegeId derived from the Google-verified ID-token email.
      // Mirrors CollegeDetector.detect() (lib/auth/services/college_detector.dart)
      // for the four sanctioned college domains; 'unknown' otherwise. Used to
      // (a) keep users.collegeId consistent with the verified email and
      // (b) bind anon-chat rooms to the caller's own college.
      function collegeIdFromEmail(email) {
        return (email != null && email.endsWith('nmit.ac.in')) ? 'nmit'
          : (email != null && email.endsWith('rvce.edu.in')) ? 'rvce'
          : (email != null && email.endsWith('bmsce.ac.in')) ? 'bms'
          : (email != null && email.endsWith('pes.edu')) ? 'pes'
          : 'unknown';
      }

      // The college-anon room id is `college_<collegeId>` (anon_home_screen.dart:150).
      // Returns true only when chatId is the requesting user's OWN college room.
      // The room id is derived server-side from users.collegeId, so a client
      // cannot name another college's room. Guard `is string` because a user
      // without a completed profile (or a non-existent user doc) has no collegeId.
      function isOwnCollegeRoom(chatId) {
        let collegeId = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.collegeId;
        return collegeId is string && chatId == 'college_' + collegeId;
      }

      // =========================
      // USERS
      // =========================
      match /users/{userId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && isOwner(userId)
          // initial collegeId must equal the email-derived value (or 'unknown')
          && request.resource.data.collegeId == collegeIdFromEmail(request.resource.data.email);

        allow update: if isSignedIn()
          && isOwner(userId)
          // collegeId is immutable: if present, it must equal the email-derived value
          && (!request.resource.data.keys().hasAny(['collegeId']) ||
              request.resource.data.collegeId == collegeIdFromEmail(resource.data.email));

        allow delete: if false;
      }

      // =========================
      // POSTS
      // =========================
      match /posts/{postId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      // =========================
      // EVENTS
      // =========================
      match /events/{eventId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if isSignedIn()
          && resource.data.createdBy == request.auth.uid;
      }

      // =========================
      // CLUB REQUESTS + NOTIFICATIONS + MEMBERS
      // =========================

      match /club_requests/{requestId} {
        // Creator always sees their own request; the platform admin sees all.
        allow read: if isSignedIn()
          && (isAdmin() || resource.data.ownerUid == request.auth.uid);

        // Only the requester can submit their own request, always pending.
        allow create: if isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.clubName is string
          && request.resource.data.clubName.size() > 0
          && request.resource.data.status == 'pending';

        // Approve/reject transitions are admin-only.
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        // Recipient-only read: no side-channel, no reading others' mail.
        allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;

        // Every notification MUST name a recipient other than the sender. This
        // fixes the historical toUid-missing bug (create_club_screen.dart) at
        // the database boundary: a notification with no recipient is rejected.
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid.size() > 0
          && request.resource.data.toUid != request.auth.uid;

        // Recipients may dismiss their own notifications.
        allow update, delete: if isSignedIn()
          && resource.data.toUid == request.auth.uid;
      }

      match /club_members/{memberId} {
        allow read: if isSignedIn();

        // Members are added by a club admin; the platform admin bootstraps the
        // requester as the club's first (admin) member on approval.
        allow create: if isSignedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
              .data.admins.hasAny([request.auth.uid])
        );
        allow update, delete: if isSignedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
              .data.admins.hasAny([request.auth.uid])
        );
      }

      // =========================
      // CLUBS
      // =========================
      match /clubs/{clubId} {
        allow read: if true;

        allow create: if isSignedIn()
          && (
            // self-creation: the creator is the sole initial admin
            request.resource.data.admins == [request.auth.uid]
            ||
            // platform-admin bootstrap on behalf of an approved requester
            // (admin_club_requests_screen._approve): the club is owned by the
            // requester, created by the admin
            (isAdmin()
             && request.resource.data.ownerUid is string
             && request.resource.data.ownerUid != request.auth.uid)
          );

        allow update, delete: if isSignedIn()
          && resource.data.admins.hasAny([request.auth.uid]);

        match /posts/{postId} {
          allow read: if true;

          allow create: if isSignedIn()
            && get(/databases/$(database)/documents/clubs/$(clubId))
                .data.members.hasAny([request.auth.uid]);

          allow update, delete: if isSignedIn()
            && get(/databases/$(database)/documents/clubs/$(clubId))
                .data.admins.hasAny([request.auth.uid]);
        }
      }

      // =========================
      // MOMENTS (EPHEMERAL)
      // =========================
      match /moments/{momentId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      // =========================
      // ANONYMOUS CHATS (STRICT COLLEGE ISOLATION)
      // =========================
      match /anon_chats/{chatId} {

        // READ: only the room's own college members
        // chatId format: "college_<collegeId>" (anon_home_screen.dart:150)
        allow read: if isSignedIn() && isOwnCollegeRoom(chatId);

        // CREATE: users create their OWN college room on first message.
        // Room doc must have: members=[uid], createdBy=uid, collegeId=users.collegeId.
        // No client-chosen chatId; must equal 'college_' + users.collegeId.
        allow create: if isSignedIn()
          && isOwnCollegeRoom(chatId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.collegeId ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.collegeId;

        // UPDATE: no room mutation (no member add/remove, no field change)
        allow update: if false;

        // DELETE: rooms persist
        allow delete: if false;

        // =========================
        // ANON MESSAGES (TTL + SENDER AUTH)
        // =========================
        match /messages/{messageId} {

          // READ: member of this college room + not expired (server time)
          allow read: if isSignedIn()
            && isOwnCollegeRoom(chatId)
            && resource.data.expiresAt > request.time;

          // CREATE: strict schema enforcement
          // - expiresAt within [request.time - 120s, request.time + 900s]:
          //   client sends expiresAt = clientNow + 90s; a 2min tolerance absorbs
          //   normal client/server clock skew, the 15min upper bound blocks a
          //   client from persisting a message permanently. The tight 90s TTL is
          //   enforced at READ (expiresAt > request.time) and by the
          //   cleanupExpiredAnonMessages Cloud Function.
          // - userId == auth.uid (no impersonation)
          // - anonId == users/{uid}.anonId (client cannot forge identity)
          // - collegeId == users/{uid}.collegeId (redundant but explicit)
          // - createdAt == request.time (server timestamp, cannot be backdated)
          // - text is non-empty string (basic shape)
          allow create: if isSignedIn()
            && isOwnCollegeRoom(chatId)
            && request.resource.data.expiresAt > request.time - duration.value(120, 's')
            && request.resource.data.expiresAt < request.time + duration.value(900, 's')
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.anonId ==
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonId
            && request.resource.data.collegeId ==
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.collegeId
            && request.resource.data.createdAt == request.time
            && request.resource.data.text is string
            // non-blank: trim() removes leading/trailing whitespace, so a
            // whitespace-only message (no real content) is rejected at write
            && request.resource.data.text.trim().size() > 0;

          // IMMUTABLE: no edits or deletes
          allow update, delete: if false;
        }
      }
    }
  }