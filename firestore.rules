rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {

      // =========================
      // AUTH HELPERS
      // =========================
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(uid) {
        return request.auth.uid == uid;
      }

      // =========================
      // USERS
      // =========================
      match /users/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if false;
      }

      // =========================
      // POSTS
      // =========================
      match /posts/{postId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      // =========================
      // EVENTS
      // =========================
      match /events/{eventId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if isSignedIn()
          && resource.data.createdBy == request.auth.uid;
      }

      // =========================
      // CLUBS
      // =========================
      match /clubs/{clubId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.admins == [request.auth.uid];

        allow update, delete: if isSignedIn()
          && resource.data.admins.hasAny([request.auth.uid]);

        match /posts/{postId} {
          allow read: if true;

          allow create: if isSignedIn()
            && get(/databases/$(database)/documents/clubs/$(clubId))
                .data.members.hasAny([request.auth.uid]);

          allow update, delete: if isSignedIn()
            && get(/databases/$(database)/documents/clubs/$(clubId))
                .data.admins.hasAny([request.auth.uid]);
        }
      }

      // =========================
      // MOMENTS (EPHEMERAL)
      // =========================
      match /moments/{momentId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      // =========================
      // ANONYMOUS CHATS (FIXED)
      // =========================
      match /anon_chats/{chatId} {

        // READ: only members can see
        allow read: if isSignedIn()
          && resource.data.members.hasAny([request.auth.uid]);

        // CREATE: creator must include themselves in members
        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members.hasAny([request.auth.uid]);

        // UPDATE: creator or member
        allow update: if isSignedIn()
          && (
            resource.data.createdBy == request.auth.uid ||
            resource.data.members.hasAny([request.auth.uid])
          );

        allow delete: if false;

        // =========================
        // ANON MESSAGES (TTL SAFE)
        // =========================
        match /messages/{messageId} {

          allow read: if isSignedIn()
            && resource.data.expiresAt > request.time;

          allow create: if isSignedIn()
            && request.resource.data.expiresAt
               <= request.time + duration.value(90, 's');

          allow update, delete: if false;
        }
      }
    }
  }