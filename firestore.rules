rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {

      // =========================
      // AUTH HELPERS
      // =========================
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(uid) {
        return request.auth.uid == uid;
      }

      // The single platform administrator (mirrors ADMIN_UID in lib/core/admin.dart).
      // Governs the club-request review flow and the club-members bootstrap.
      function isAdmin() {
        return request.auth.uid == 'OImOQirOL7eQNftKASo4FTrF6XA3';
      }

      // Canonical collegeId derived from the Google-verified ID-token email.
      // Mirrors CollegeDetector.detect() (lib/auth/services/college_detector.dart)
      // for the four sanctioned college domains; 'unknown' otherwise. Used to
      // (a) keep users.collegeId consistent with the verified email and
      // (b) bind anon-chat rooms to the caller's own college.
      function collegeIdFromEmail(email) {
        return (email != null && email.endsWith('nmit.ac.in')) ? 'nmit'
          : (email != null && email.endsWith('rvce.edu.in')) ? 'rvce'
          : (email != null && email.endsWith('bmsce.ac.in')) ? 'bms'
          : (email != null && email.endsWith('pes.edu')) ? 'pes'
          : 'unknown';
      }

      // The college-anon room id is `college_<collegeId>` (anon_home_screen.dart:150).
      // Returns true only when chatId is the requesting user's OWN college room.
      // The room id is derived server-side from users.collegeId, so a client
      // cannot name another college's room. Guard `is string` because a user
      // without a completed profile (or a non-existent user doc) has no collegeId.
      function userCollege() {
  return get(
    /databases/$(database)/documents/users/$(request.auth.uid)
  ).data.collegeId;
}

function postCollege(postId) {
  return get(
    /databases/$(database)/documents/posts/$(postId)
  ).data.collegeId;
}

function isOwnCollegeRoom(chatId) {
        let collegeId = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.collegeId;
        return collegeId is string && chatId == 'college_' + collegeId;
      }

      // =========================
      // USERS
      // =========================
      match /users/{userId} {
        // College-isolated directory. A profile is readable only by members of
        // the SAME college (the search screen's `where('collegeId')` query) and
        // by the platform admin (bootstrap/oversight). An unfiltered users query
        // is now rejected at the database boundary, closing the global profile
        // enumeration previously possible from search/start-conversation.
        allow read: if isSignedIn()
          && (resource.data.collegeId == userCollege() || isAdmin());

        allow create: if isSignedIn()
          && isOwner(userId)
          // initial collegeId must equal the email-derived value (or 'unknown')
          && request.resource.data.collegeId == collegeIdFromEmail(request.resource.data.email);

        allow update: if isSignedIn()
          && isOwner(userId)
          // collegeId is immutable: if present, it must equal the email-derived value
          && (!request.resource.data.keys().hasAny(['collegeId']) ||
              request.resource.data.collegeId == collegeIdFromEmail(resource.data.email));

        allow delete: if false;
      }

      // =========================
      // POSTS (COLLEGE ISOLATED FEED)
      // =========================
      // The campus feed is college-scoped: a post is only readable by members
      // of the college stamped on it (written from the owner's users.collegeId).
      // Posts from earlier builds have no collegeId -> denied (strictest-first;
      // a one-time backfill can migrate them, see docs/security-college-isolation.md).
      match /posts/{postId} {
        allow read: if isSignedIn()
          && resource.data.collegeId == userCollege();

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.collegeId == userCollege();

        // Owner edits freely; a same-college peer may only bump the like or
        // comment counter (feed toggle / add-comment), never touch content.
        allow update: if isSignedIn()
          && resource.data.collegeId == userCollege()
          && (
            resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likesCount'])
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['commentsCount'])
          );

        allow delete: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.collegeId == userCollege();

        // ---- likes (one per user, keyed by uid) ----
        match /likes/{likeId} {
          allow read: if isSignedIn() && postCollege(postId) == userCollege();

          allow create: if isSignedIn()
            && postCollege(postId) == userCollege()
            && request.resource.data.userId == request.auth.uid;

          allow delete: if isSignedIn()
            && postCollege(postId) == userCollege()
            && resource.data.userId == request.auth.uid;

          allow update: if false;
        }

        // ---- comments ----
        match /comments/{commentId} {
          allow read: if isSignedIn() && postCollege(postId) == userCollege();

          allow create: if isSignedIn()
            && postCollege(postId) == userCollege()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.trim().size() > 0;

          allow update, delete: if isSignedIn()
            && postCollege(postId) == userCollege()
            && resource.data.userId == request.auth.uid;
        }
      }

      // =========================
      // EVENTS
      // =========================
      match /events/{eventId} {
        // College-scoped, mirroring the campus feed: an event is readable only
        // by members of the college stamped on it (written from the creator's
        // users.collegeId). Legacy unstamped events are hidden (strictest-first).
        allow read: if isSignedIn()
          && resource.data.collegeId == userCollege();

        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.collegeId == userCollege();

        allow update, delete: if isSignedIn()
          && resource.data.createdBy == request.auth.uid
          && resource.data.collegeId == userCollege();
      }

      // =========================
      // CLUB REQUESTS + NOTIFICATIONS + MEMBERS
      // =========================

      match /club_requests/{requestId} {
        // Creator always sees their own request; the platform admin sees all.
        allow read: if isSignedIn()
          && (isAdmin() || resource.data.ownerUid == request.auth.uid);

        // Only the requester can submit their own request, always pending.
        // A student-ID upload is mandatory (create_club_screen uploads to the
        // club_id_cards Supabase bucket and stores the URL) — a request with no
        // identity card is rejected so the admin review always has something
        // to verify.
        allow create: if isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.clubName is string
          && request.resource.data.clubName.size() > 0
          && request.resource.data.status == 'pending'
          && request.resource.data.idCardUrl is string
          && request.resource.data.idCardUrl.size() > 0;

        // Approve/reject transitions are admin-only.
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        // Recipient-only read: no side-channel, no reading others' mail.
        allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;

        // Every notification MUST name a recipient other than the sender. This
        // fixes the historical toUid-missing bug (create_club_screen.dart) at
        // the database boundary: a notification with no recipient is rejected.
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid.size() > 0
          && request.resource.data.toUid != request.auth.uid;

        // Recipients may dismiss their own notifications.
        allow update, delete: if isSignedIn()
          && resource.data.toUid == request.auth.uid;
      }

      match /club_members/{memberId} {
        // Membership is private: a user may read their OWN membership rows
        // (the "Your clubs" query is `where userId == uid`), a club's admins
        // may read that club's rows, and the platform admin may read all.
        // Previously any signed-in user could enumerate everyone's clubs.
        allow read: if isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/clubs/$(resource.data.clubId))
                .data.admins.hasAny([request.auth.uid])
            || isAdmin()
          );

        // Members are added by a club admin; the platform admin bootstraps the
        // requester as the club's first (admin) member on approval.
        allow create: if isSignedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
              .data.admins.hasAny([request.auth.uid])
        );
        allow update, delete: if isSignedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
              .data.admins.hasAny([request.auth.uid])
        );
      }

      match /club_join_requests/{requestId} {
        // Applicants may read their OWN pending request ("Request to Join");
        // a club's admins review and act on its pending requests; the platform
        // admin oversees all.
        allow read: if isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || isAdmin()
            || get(/databases/$(database)/documents/clubs/$(resource.data.clubId))
                .data.admins.hasAny([request.auth.uid])
          );

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.clubId is string
          && request.resource.data.clubId.size() > 0
          && request.resource.data.status == 'pending';

        // Only the club's admins resolve requests (approve/decline/clear).
        allow update, delete: if isSignedIn()
          && (
            isAdmin()
            || get(/databases/$(database)/documents/clubs/$(resource.data.clubId))
                .data.admins.hasAny([request.auth.uid])
          );
      }

      // =========================
      // 1:1 CHATS (MEMBERSHIP-SCOPED)
      // =========================
      // Authz is by the members array, not college: a 1:1 chat is private to
      // its two members. chatId = sorted-joined member uids (chat_screen.dart),
      // and create requires canonical sorted order so a pair cannot mint
      // duplicate rooms or read another pair's chat.
      function isChatMember(chatId) {
        let members = get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.members;
        return members is list && members.hasAny([request.auth.uid]);
      }

      match /chats/{chatId} {
        allow read: if isSignedIn() && isChatMember(chatId);

        allow create: if isSignedIn()
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll([request.auth.uid])
          && request.resource.data.members[0] != request.resource.data.members[1]
          && request.resource.data.members[0] < request.resource.data.members[1];

        // Any member updates the conversation footer (lastMessage preview).
        allow update: if isSignedIn() && isChatMember(chatId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastMessageAt']);

        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isSignedIn() && isChatMember(chatId);

          // Immutable once sent; the author is the sender; recipient differs.
          allow create: if isSignedIn()
            && isChatMember(chatId)
            && request.resource.data.fromUid == request.auth.uid
            && request.resource.data.toUid is string
            && request.resource.data.toUid != request.auth.uid
            && request.resource.data.toUid.size() > 0
            && request.resource.data.text is string
            && request.resource.data.text.trim().size() > 0
            && request.resource.data.status == 'sent'
            && request.resource.data.createdAt == request.time;

          // Only the RECIPIENT may bump status (sent -> delivered -> seen).
          allow update: if isSignedIn()
            && isChatMember(chatId)
            && resource.data.toUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status']);

          allow delete: if false;
        }
      }

      // =========================
      // FRIENDS + FRIEND REQUESTS
      // =========================
      match /friends/{friendId} {
        // Visible only to the two friends; a friends-list query
        // (`where members arrayContains uid`) passes because every returned
        // doc contains the caller.
        allow read: if isSignedIn()
          && resource.data.members is list
          && resource.data.members.hasAny([request.auth.uid]);

        // Mutual two-person edge: the actor is one member, the other differs.
        // friendsCount counters are bumped server-side (friendCreated Cloud
        // Function) so no client writes a peer's users doc.
        allow create: if isSignedIn()
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll([request.auth.uid])
          && request.resource.data.members[0] != request.resource.data.members[1];

        allow update: if false;

        allow delete: if isSignedIn()
          && resource.data.members.hasAny([request.auth.uid]);
      }

      match /friend_requests/{requestId} {
        // Reachable only by the sender or the recipient.
        allow read: if isSignedIn()
          && (resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid.size() > 0
          && request.resource.data.toUid != request.auth.uid
          && request.resource.data.status == 'pending';

        // Only the recipient decides (accept/decline).
        allow update: if isSignedIn()
          && resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status']);

        // Sender may withdraw; recipient clears on accept/decline.
        allow delete: if isSignedIn()
          && (resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid);
      }

      // =========================
      // CLUB CHATS (MEMBERSHIP-GATED)
      // =========================
      // Visible to club members; authored by the member. Membership is derived
      // from club_members/{clubId}_{userId} (the clubs doc carries admins, no
      // members array) — same source the join flow writes.
      function isClubMember(clubId) {
        let memberId = clubId + '_' + request.auth.uid;
        return exists(
          /databases/$(database)/documents/club_members/$(memberId)
        );
      }

      match /club_chats/{clubId}/messages/{messageId} {
        allow read: if isSignedIn() && isClubMember(clubId);

        allow create: if isSignedIn()
          && isClubMember(clubId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() > 0
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // =========================
      // CLUBS
      // =========================
      match /clubs/{clubId} {
        allow read: if true;

        allow create: if isSignedIn()
          && (
            // self-creation: the creator is the sole initial admin
            request.resource.data.admins == [request.auth.uid]
            ||
            // platform-admin bootstrap on behalf of an approved requester
            // (admin_club_requests_screen._approve): the club is owned by the
            // requester, created by the admin
            (isAdmin()
             && request.resource.data.ownerUid is string
             && request.resource.data.ownerUid != request.auth.uid)
          );

        allow update, delete: if isSignedIn()
          && resource.data.admins.hasAny([request.auth.uid]);

        match /posts/{postId} {
          allow read: if true;

          // Membership comes from club_members/{clubId}_{uid} (the clubs doc
          // carries admins only, no members array) — same source club_chats uses.
          allow create: if isSignedIn()
            && isClubMember(clubId);

          allow update, delete: if isSignedIn()
            && get(/databases/$(database)/documents/clubs/$(clubId))
                .data.admins.hasAny([request.auth.uid]);
        }
      }

      // =========================
      // ANONYMOUS CHATS (STRICT COLLEGE ISOLATION)
      // =========================
      match /anon_chats/{chatId} {

        // READ: only the room's own college members
        // chatId format: "college_<collegeId>" (anon_home_screen.dart:150)
        allow read: if isSignedIn() && isOwnCollegeRoom(chatId);

        // CREATE: users create their OWN college room on first message.
        // Room doc must have: members=[uid], createdBy=uid, collegeId=users.collegeId.
        // No client-chosen chatId; must equal 'college_' + users.collegeId.
        allow create: if isSignedIn()
          && isOwnCollegeRoom(chatId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.collegeId ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.collegeId;

        // UPDATE: no room mutation (no member add/remove, no field change)
        allow update: if false;

        // DELETE: rooms persist
        allow delete: if false;

        // =========================
        // ANON MESSAGES (TTL + SENDER AUTH)
        // =========================
        match /messages/{messageId} {

          // READ: member of this college room + not expired (server time)
          allow read: if isSignedIn()
            && isOwnCollegeRoom(chatId)
            && resource.data.expiresAt > request.time;

          // CREATE: strict schema enforcement
          // - expiresAt within [request.time - 120s, request.time + 900s]:
          //   client sends expiresAt = clientNow + 90s; a 2min tolerance absorbs
          //   normal client/server clock skew, the 15min upper bound blocks a
          //   client from persisting a message permanently. The tight 90s TTL is
          //   enforced at READ (expiresAt > request.time) and by the
          //   cleanupExpiredAnonMessages Cloud Function.
          // - userId == auth.uid (no impersonation)
          // - anonId == users/{uid}.anonId (client cannot forge identity)
          // - collegeId == users/{uid}.collegeId (redundant but explicit)
          // - createdAt == request.time (server timestamp, cannot be backdated)
          // - text is non-empty string (basic shape)
          allow create: if isSignedIn()
            && isOwnCollegeRoom(chatId)
            && request.resource.data.expiresAt > request.time - duration.value(120, 's')
            && request.resource.data.expiresAt < request.time + duration.value(900, 's')
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.anonId ==
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonId
            && request.resource.data.collegeId ==
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.collegeId
            && request.resource.data.createdAt == request.time
            && request.resource.data.text is string
            // non-blank: trim() removes leading/trailing whitespace, so a
            // whitespace-only message (no real content) is rejected at write
            && request.resource.data.text.trim().size() > 0;

          // IMMUTABLE: no edits or deletes
          allow update, delete: if false;
        }
      }
    }
  }